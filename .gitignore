# Build artefacts
/build/ip2loc
/build/*.test
*.test
coverage.out
*.cover

# Local mmdb files (large, never commit)
/data/
/db/*.mmdb

# CI-prefetched mmdb cache (downloaded by .github/workflows/ci.yaml into
# ./db-cache/ before each docker build). The .gitkeep placeholder is kept
# so the directory exists in the build context for local builds.
/db-cache/*.mmdb

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

# Go
*.exe
*.dll
*.so
*.dylib
